generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // For Neon Postgres in production: change to "postgresql"
  url      = env("DATABASE_URL")
}

model Folder {
  id        String     @id @default(uuid())
  name      String
  icon      String?    @default("Folder")
  parentId  String?
  parent    Folder?    @relation("SubFolders", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]   @relation("SubFolders")
  documents Document[]
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Document {
  id           String   @id @default(uuid())
  title        String
  slug         String?
  packages     String? // e.g. "npm i jsonwebtoken @types/jsonwebtoken" or JSON
  theory       String // Clear, non-boring conceptual explanation
  codePractice String // Practical code implementation
  codeLanguage String   @default("typescript")
  fileName     String?  @default("index.ts") // File tab name like in VS Code
  codeFiles    String? // JSON serialized array of CodeFile[] for multi-file snippets
  notes        String? // Gotchas & key tips
  tags         String?  @default("") // Comma-separated tags e.g. "auth,jwt,security"
  folderId     String?
  folder       Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Setting {
  id           String   @id @default("default")
  activeTheme  String   @default("crimson-charcoal")
  viewMode     String   @default("graph")
  customConfig String?
  updatedAt    DateTime @updatedAt
}
